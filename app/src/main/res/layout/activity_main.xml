<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:orientation="vertical"
	android:layout_width="match_parent"
	android:layout_height="match_parent">

    <include layout="@layout/activity_home" />

	<LinearLayout
		android:id="@+id/activity_mainLinearLayout"
		android:focusable="true"
		android:focusableInTouchMode="true"
		android:layout_width="fill_parent"
		android:layout_height="fill_parent"
		android:orientation="vertical"
		android:gravity="bottom|center">


		<RelativeLayout
			android:visibility="gone"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginLeft="10dp"
			android:layout_marginRight="10dp"
			android:layout_marginTop="10dp">

			<LinearLayout
				android:layout_width="fill_parent"
				android:layout_height="50dp"
				android:gravity="center"
				android:layout_marginTop="3dp"
				android:background="@drawable/vince9">

				<RelativeLayout
					android:layout_width="match_parent"
					android:layout_height="match_parent">

					<ImageView
						android:layout_width="20dp"
						android:layout_height="match_parent"
						android:src="@drawable/ic_more"
						android:layout_alignParentRight="true"
						android:adjustViewBounds="true"
						android:tint="?colorAccent"
						android:layout_marginRight="5dp"/>

				</RelativeLayout>

				<RelativeLayout
					android:visibility="gone"
					android:layout_width="100dp"
					android:layout_height="match_parent"
					android:background="#66B2FF"
					android:gravity="center">

					<TextView
						android:id="@+id/activity_mainAutorText"
						android:layout_height="0dp"
						android:layout_width="wrap_content"
						android:text="CRIE SEU LOGIN TESTE"
						android:textStyle="bold"
						android:textColor="#00BAFF"/>

				</RelativeLayout>

			</LinearLayout>

			<LinearLayout
				android:visibility="gone"
				android:orientation="horizontal"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="right">

				<RelativeLayout
					android:layout_width="110dp"
					android:layout_height="wrap_content"
					android:gravity="center">

					<RelativeLayout
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:background="@drawable/vince7">

						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="SERVER|PORT"
							android:typeface="monospace"
							android:textSize="7sp"
							android:layout_marginLeft="5dp"
							android:layout_marginRight="5dp"
							android:textColor="#FFFFFF"
							android:shadowColor="#FF0000"
							android:shadowRadius="10"/>

					</RelativeLayout>

				</RelativeLayout>

			</LinearLayout>

		</RelativeLayout>

		<RelativeLayout
			android:visibility="gone"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginLeft="10dp"
			android:layout_marginRight="10dp"
			android:layout_marginTop="10dp">

			<LinearLayout
				android:layout_width="fill_parent"
				android:layout_height="50dp"
				android:gravity="center"
				android:layout_marginTop="3dp"
				android:background="@drawable/vince9">

				<RelativeLayout
					android:layout_width="match_parent"
					android:layout_height="match_parent">

					<ImageView
						android:layout_width="20dp"
						android:layout_height="match_parent"
						android:src="@drawable/ic_more"
						android:layout_alignParentRight="true"
						android:adjustViewBounds="true"
						android:tint="?colorAccent"
						android:layout_marginRight="5dp"/>

				</RelativeLayout>

				<RelativeLayout
					android:visibility="gone"
					android:layout_width="150dp"
					android:layout_height="match_parent"
					android:background="#66B2FF"
					android:gravity="center">

					<TextView
						android:textAppearance="?android:textAppearanceSmall"
						android:typeface="monospace"
						android:textStyle="bold"
						android:textColor="#000000"
						android:gravity="center"
						android:id="@+id/edson"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginLeft="3.0dip"
						android:layout_marginTop="2.0dip"
						android:text="Desconectado"/>

				</RelativeLayout>

			</LinearLayout>

			<LinearLayout
				android:visibility="gone"
				android:orientation="horizontal"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="right">

				<RelativeLayout
					android:layout_width="110dp"
					android:layout_height="wrap_content"
					android:gravity="center">

					<RelativeLayout
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:background="@drawable/vince7">

						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="PAYLOAD|STATUS"
							android:typeface="monospace"
							android:textSize="7sp"
							android:layout_marginLeft="5dp"
							android:layout_marginRight="5dp"
							android:textColor="#FFFFFF"
							android:shadowColor="#FF0000"
							android:shadowRadius="10"/>

					</RelativeLayout>

				</RelativeLayout>

			</LinearLayout>

		</RelativeLayout>

		<LinearLayout
			android:visibility="gone"
			android:id="@+id/activity_mainInputPasswordLayout"
			android:layout_height="wrap_content"
			android:layout_width="match_parent"
			android:orientation="vertical"
			android:gravity="center"
			android:paddingLeft="20dp"
			android:paddingRight="20dp"
			android:paddingBottom="5dp"
			android:layout_gravity="center">

			<LinearLayout
				android:layout_height="0dp"
				android:layout_width="match_parent"
				android:orientation="horizontal"
				android:gravity="center"
				android:paddingBottom="10dp">

				<TextView
					android:layout_height="wrap_content"
					android:layout_width="wrap_content"
					android:text="@string/title_login_main"
					android:textStyle="bold"
					android:textSize="18sp"
					android:textColor="@color/colorText"/>

			</LinearLayout>

			<RelativeLayout
				android:visibility="gone"
				android:layout_width="match_parent"
				android:layout_height="0dp"
				android:orientation="vertical"
				android:layout_marginBottom="5dp">

				<RelativeLayout
					android:layout_width="match_parent"
					android:layout_height="45dp"
					android:background="@drawable/h_spin_shp1"
					android:id="@+id/h_u_l"
					android:layout_margin="5dp">

					<android.support.design.widget.TextInputEditText
						android:id="@+id/activity_mainInputPasswordUserEdit"
						android:background="@null"
						android:layout_width="fill_parent"
						android:layout_height="match_parent"
						android:hint="Usuario"
						android:imeOptions="actionUnspecified|normal"
						android:nextFocusDown="@+id/HarliePasss"
						android:singleLine="true"
						android:inputType="text"
						android:textSize="14sp"
						android:layout_centerInParent="true"
						android:layout_alignParentRight="true"
						android:layout_marginLeft="40dp"
						android:textColorHint="#000000"
						android:paddingLeft="5dp"/>

					<ImageView
						android:tint="@color/h_c"
						android:layout_width="29dp"
						android:layout_height="29dp"
						android:src="@drawable/h_acnt"
						android:layout_margin="10dp"/>

				</RelativeLayout>

				<TextView
					android:visibility="gone"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:textStyle="italic"
					android:text="Usuario"
					android:layout_marginLeft="25dp"
					android:background="@drawable/ic_gaming"
					android:textColor="#000000"
					android:textSize="10sp"
					android:padding="2dp"
					android:layout_marginTop="-4dp"/>

			</RelativeLayout>

			<RelativeLayout
				android:visibility="gone"
				android:layout_width="wrap_content"
				android:layout_height="0dp">

				<RelativeLayout
					android:layout_width="match_parent"
					android:layout_height="45dp"
					android:background="@drawable/h_spin_shp1"
					android:id="@+id/fragment_userpassTextInputLayout"
					android:gravity="center"
					android:layout_margin="5dp"
					android:layout_marginTop="5dp">

					<android.support.design.widget.TextInputEditText
						android:id="@+id/activity_mainInputPasswordPassEdit"
						android:background="@null"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:hint="Senha"
						android:singleLine="true"
						android:textSize="14sp"
						android:inputType="textPassword"
						android:layout_centerInParent="true"
						android:layout_alignParentLeft="true"
						android:layout_marginLeft="40dp"
						android:textColorHint="#000000"
						android:paddingLeft="5dp"/>

					<ImageView
						android:tint="@color/h_c"
						android:layout_width="29dp"
						android:layout_height="29dp"
						android:src="@drawable/h_pass"
						android:layout_margin="10dp"/>

					<ImageButton
						android:padding="10dp"
						android:background="@android:color/transparent"
						android:layout_alignEnd="@id/activity_mainInputPasswordPassEdit"
						android:id="@+id/show_password"
						android:src="@drawable/ic_visibility_black_24dp"
						android:layout_width="wrap_content"
						android:layout_height="match_parent"
						android:hint="@string/show_password"
						android:layout_gravity="right"/>

				</RelativeLayout>

				<TextView
					android:visibility="gone"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:textStyle="italic"
					android:text="Senha"
					android:layout_marginLeft="25dp"
					android:background="@drawable/ic_gaming"
					android:textColor="#000000"
					android:textSize="10sp"
					android:padding="2dp"
					android:layout_marginTop="-4dp"/>

			</RelativeLayout>

		</LinearLayout>

		<LinearLayout
			android:visibility="gone"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal">

			<TextView
				android:letterSpacing="0.1"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Servidor"
				android:textSize="12dp"/>

			<TextView
				android:visibility="gone"
				android:layout_marginLeft="10dp"
				android:layout_marginRight="10dp"
				android:letterSpacing="0.1"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="SELECT PORT"
				android:textSize="12dp"/>

		</LinearLayout>

		<LinearLayout
			android:visibility="gone"
			android:layout_marginLeft="10dp"
			android:layout_marginRight="10dp"
			android:left="10dp"
			android:right="10dp"
			android:background="@drawable/background_rounded"
			android:layout_marginTop="25dp"
			android:layout_marginBottom="10dp"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal">

			<Spinner
				style="@style/SpinnerTheme"
				android:textColor="@color/gray"
				android:layout_marginLeft="5dp"
				android:layout_marginRight="5dp"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:prompt="@string/category_prompt"
				android:id="@+id/serverSpinner"/>

			<Spinner
				android:visibility="gone"
				android:layout_marginTop="5dp"
				android:layout_marginLeft="5dp"
				android:layout_marginRight="5dp"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:prompt="@string/category_prompt"
				android:id="@+id/proxyxx"/>

		</LinearLayout>

		<TextView
			android:layout_marginLeft="10dp"
			android:layout_marginRight="10dp"
			android:letterSpacing="0.1"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text=""
			android:textSize="12dp"/>

		<LinearLayout
			android:visibility="gone"
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:orientation="horizontal">

			<TextView
				android:letterSpacing="0.1"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Payload"
				android:textSize="12dp"/>

		</LinearLayout>

		<LinearLayout
			android:visibility="gone"
			android:layout_marginLeft="10dp"
			android:layout_marginRight="10dp"
			android:left="10dp"
			android:right="10dp"
			android:background="@drawable/background_rounded"
			android:layout_marginTop="125dp"
			android:layout_marginBottom="10dp"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal">

			<Spinner
				style="@style/SpinnerTheme"
				android:layout_marginLeft="5dp"
				android:layout_marginRight="5dp"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:prompt="@string/category_prompt"
				android:id="@+id/payloadSpinner"/>

		</LinearLayout>

		

		<LinearLayout
			android:visibility="gone"
			android:id="@+id/activity_mainInputPayloadLinearLayout"
			android:layout_height="wrap_content"
			android:layout_width="match_parent"
			android:orientation="vertical"
			android:layout_marginTop="3dp"
			android:padding="10dp">

			<android.support.design.widget.TextInputLayout
				android:visibility="gone"
				android:layout_width="match_parent"
				android:layout_height="wrap_content">

				<android.support.design.widget.TextInputEditText
					android:id="@+id/activity_mainInputPayloadEditText"
					android:inputType="textMultiLine|textLongMessage"
					android:layout_width="fill_parent"
					android:layout_height="wrap_content"
					android:ems="20"
					android:visibility="gone"
					android:textColor="@color/colorText"
					android:hint="@string/payload"/>

			</android.support.design.widget.TextInputLayout>

		</LinearLayout>

		<LinearLayout
			android:visibility="gone"
			android:id="@+id/activity_mainMetodoConexaoLayout"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:background="@drawable/vince9"
			android:gravity="center"
			android:padding="5dp"
			android:layout_marginTop="3dp">

			<TextView
				android:id="@+id/activity_mainMetodoConexaoText"
				android:layout_height="wrap_content"
				android:layout_width="wrap_content"
				android:letterSpacing="0.1"
				android:text="CONNECTION METHOD"
				android:textStyle="normal"/>

			<RadioGroup
				android:id="@+id/activity_mainMetodoConexaoRadio"
				android:layout_height="wrap_content"
				android:layout_width="match_parent"
				android:orientation="horizontal"
				android:breakStrategy="balanced"
				android:gravity="center">

				<android.support.v7.widget.AppCompatRadioButton
					android:id="@+id/activity_mainSSHDirectRadioButton"
					android:layout_height="wrap_content"
					android:layout_width="wrap_content"
					android:hint="SSH DIRECT"
					android:padding="5dp"/>

				<android.support.v7.widget.AppCompatRadioButton
					android:id="@+id/activity_mainSSHProxyRadioButton"
					android:layout_height="wrap_content"
					android:layout_width="wrap_content"
					android:hint="SSH + PROXY"/>

				<android.support.v7.widget.AppCompatRadioButton
					android:id="@+id/activity_mainSSL"
					android:layout_height="wrap_content"
					android:layout_width="wrap_content"
					android:hint="SSH + SSL"/>

			</RadioGroup>

			<android.support.v7.widget.SwitchCompat
				android:id="@+id/activity_mainCustomPayloadSwitch"
				android:layout_height="wrap_content"
				android:layout_width="wrap_content"
				android:hint="Custom Payload"
				android:layout_gravity="right"/>

		</LinearLayout>

		<LinearLayout
			android:id="@+id/activity_mainInputProxyLayout"
			android:layout_height="wrap_content"
			android:layout_width="match_parent"
			android:orientation="horizontal"
			android:padding="5dp"
			android:layout_marginTop="3dp"
			android:visibility="gone">

			<LinearLayout
				android:layout_height="wrap_content"
				android:layout_width="wrap_content"
				android:orientation="vertical"
				android:paddingRight="10dp"
				android:paddingLeft="10dp"
				android:visibility="gone"
				android:layout_gravity="start">

				<TextView
					android:layout_height="wrap_content"
					android:layout_width="wrap_content"
					android:text="@string/proxy_remote"
					android:textStyle="bold"/>

				<TextView
					android:id="@+id/activity_mainProxyText"
					android:layout_height="wrap_content"
					android:layout_width="wrap_content"
					android:text="@string/no_value"/>

			</LinearLayout>

			<LinearLayout
				android:layout_height="match_parent"
				android:layout_width="fill_parent"
				android:orientation="vertical"
				android:visibility="gone"
				android:layout_gravity="right">

				<ImageView
					android:visibility="gone"
					android:layout_height="match_parent"
					android:layout_width="30dp"
					android:src="@drawable/ic_mode_edit_black_48dp"
					android:layout_gravity="end"/>

			</LinearLayout>

		</LinearLayout>

		<LinearLayout
			android:id="@+id/activity_mainInputSNILayout"
			android:layout_height="wrap_content"
			android:layout_width="match_parent"
			android:orientation="horizontal"
			android:padding="5dp"
			android:layout_marginTop="3dp"
			android:visibility="gone"
			android:gravity="center_horizontal"
			android:onClick="showCustomSNI">

			<LinearLayout
				android:layout_height="wrap_content"
				android:layout_width="wrap_content"
				android:orientation="vertical"
				android:paddingRight="10dp"
				android:paddingLeft="10dp"
				android:visibility="gone"
				android:layout_gravity="start">

				<TextView
					android:layout_height="wrap_content"
					android:layout_width="wrap_content"
					android:text="Custom SNI"
					android:textStyle="bold"/>

				<TextView
					android:id="@+id/activity_mainSNIText"
					android:layout_height="wrap_content"
					android:layout_width="wrap_content"
					android:text="@string/no_value"/>

			</LinearLayout>

			<LinearLayout
				android:visibility="gone"
				android:layout_height="match_parent"
				android:layout_width="fill_parent"
				android:orientation="vertical"

				android:layout_gravity="right">

				<ImageView
					android:layout_height="match_parent"
					android:layout_width="30dp"
					android:src="@drawable/ic_mode_edit_black_48dp"
					android:layout_gravity="end"/>

			</LinearLayout>

		</LinearLayout>

		<com.google.android.gms.ads.AdView
			xmlns:ads="http://schemas.android.com/apk/res-auto"
			android:id="@+id/adBannerMainView"
			android:layout_width="0dp"
			android:layout_height="0dp"
			android:layout_centerHorizontal="true"
			android:layout_alignParentBottom="true"
			android:layout_marginTop="3dp"
			android:visibility="gone"
			ads:adSize="BANNER"
			ads:adUnitId="ca-app-pub-6560862030501171/3101206569"
			android:layout_gravity="center">

		</com.google.android.gms.ads.AdView>

		<LinearLayout
			android:visibility="gone"
			android:id="@+id/activity_mainMensagemConfigLinearLayout"
			android:layout_height="wrap_content"
			android:layout_width="match_parent"
			android:orientation="vertical"
			android:layout_margin="5dp"
			android:background="@drawable/background_rounded"
			android:padding="10dp">

			<TextView
				android:visibility="gone"
				android:id="@+id/activity_mainMensagemConfigTextView"
				android:layout_height="wrap_content"
				android:layout_width="wrap_content"
				android:autoLink="web"/>

		</LinearLayout>

	</LinearLayout>

</LinearLayout>

